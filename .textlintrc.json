{
  "plugins": {
    "mdx": true
  },
  "filters": {
    "comments": true,
    "node-types": {
      "nodeTypes": ["BlockQuote", "Html"]
    }
  },
  "rules": {
    "preset-ja-technical-writing": {
      "sentence-length": false,
      "no-exclamation-question-mark": false
    },
    "preset-japanese": {
      "sentence-length": {
        "max": 200
      }
    }
  }
}
